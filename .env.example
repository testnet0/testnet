# TestNet Environment Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env with real secrets!

# Database Configuration (PostgreSQL)
DB_ROOT_PASSWORD=your_secure_mysql_password_here

# JWT Secret (minimum 64 characters, use: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_at_least_64_characters_long_here

# Client Registration Secret
TESTNET_CLIENT_SECRET=your_client_registration_secret_here

# Admin Initial Password
ADMIN_INIT_PASSWORD=your_admin_password_here

# Scanning Node Name (optional, defaults to Node-<hostname>)
TESTNET_NODE_NAME=

# Docker Registry (optional, leave empty for Docker Hub)
DOCKER_REGISTRY=

# CORS Allowed Origins (comma-separated, supports wildcard * patterns)
# Replace with your actual access URL in production, e.g. https://your-domain.com
# Default allows any origin with any protocol/port
CORS_ALLOWED_ORIGINS=*

# TestNet Version
TESTNET_VERSION=v3.0.1

# License (set to true in production)
LICENSE_ENABLED=false
